@article{DIESTEL2003197,
title = {Graph-theoretical versus topological ends of graphs},
journal = {Journal of Combinatorial Theory, Series B},
volume = {87},
number = {1},
pages = {197-206},
year = {2003},
issn = {0095-8956},
doi = {https://doi.org/10.1016/S0095-8956(02)00034-5},
url = {https://www.sciencedirect.com/science/article/pii/S0095895602000345},
author = {Reinhard Diestel and Daniela Kühn},
abstract = {We compare the notions of an end that exist in the graph-theoretical and, independently, in the topological literature. These notions conflict except for locally finite graphs, and we show how each can be expressed in the context of the other. We find that the topological ends of a graph are precisely the undominated of its graph-theoretical ends, and that graph theoretical ends have a simple topological description generalizing the definition of a topological end.}
}

